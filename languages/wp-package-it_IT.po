#: includes/map.php:199 templates/search.php:47
msgid "Map"
msgstr "Mappa"

#. translators: 1: parameter name chosen by the theme, 2: parameter key, 3: default name used instead
#: includes/search.php:54
#, php-format
msgid ""
"«%1$s» cannot be the name of the «%2$s» parameter (empty, already used, or a "
"WordPress query var): «%3$s» is used instead."
msgstr ""
"«%1$s» non può essere il nome del parametro «%2$s» (vuoto, già usato o query "
"var di WordPress): si usa «%3$s»."

#. translators: 1: filter key chosen by the theme, 2: key used instead
#: includes/search.php:79
#, php-format
msgid ""
"The filter key «%1$s» is a WordPress query var or a search parameter: «%2$s» "
"is used instead."
msgstr ""
"La chiave del filtro «%1$s» è una query var di WordPress o un parametro "
"della ricerca: si usa «%2$s»."

