#: assets/js/map-embed.js:15 assets/js/search.js:912
msgid "The map is not available right now. Please try again later."
msgstr "La mappa non è disponibile in questo momento. Riprova più tardi."

#: assets/js/map-embed.js:33 assets/js/search.js:871
msgid "Zoom in on the map"
msgstr "Ingrandisci la mappa"

#: assets/js/map-embed.js:34 assets/js/search.js:872
msgid "Zoom out of the map"
msgstr "Riduci la mappa"

#: assets/js/map-embed.js:35 assets/js/search.js:873
msgid "Show the map full screen"
msgstr "Mappa a schermo intero"

#: assets/js/map-embed.js:36 assets/js/search.js:874
