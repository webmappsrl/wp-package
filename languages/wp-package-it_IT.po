msgstr "Mappa: frecce per spostarla, + e − per ingrandire e ridurre"

#: assets/js/search.js:351
msgid "All"
msgstr "Tutti"

#. translators: %s: code and name of the result (e.g. C 104 A Andala Segura)
#: assets/js/search.js:406
msgid "Select %s"
msgstr "Seleziona %s"

#. translators: %s: number and type of results (e.g. 1 trail)
#: assets/js/search.js:512
msgid "Select %s in this search"
msgstr "Seleziona %s della ricerca"

#. translators: %s: number and type of results (e.g. 42 trails)
#: assets/js/search.js:515
msgid "Select all %s in this search"
msgstr "Seleziona tutti i %s della ricerca"

#. translators: 1: number and type of results (e.g. 3 trails), 2: file format (e.g. GPX)
#: assets/js/search.js:558
msgid "Download %1$s as %2$s"
msgstr "Scarica %1$s in %2$s"

#. translators: 1: results ready, 2: number and type of results (e.g. 769 trails)
#: assets/js/search.js:589
msgid "Preparing the file: %1$s of %2$s"
msgstr "Preparo il file: %1$s di %2$s"

#: assets/js/search.js:598
msgid "None of the selected results has a route."
msgstr "Nessuno dei risultati scelti ha un tracciato."

#. translators: 1: number and type of results (e.g. 3 trails), 2: file format (e.g. GPX)
#: assets/js/search.js:603
msgid "File ready: %1$s as %2$s."
msgstr "File pronto: %1$s in %2$s."

#. translators: %s: number and type of results (e.g. 2 trails)
#: assets/js/search.js:606
msgid "Not included because they have no route: %s."
msgstr "Non inclusi perché senza tracciato: %s."

#: assets/js/search.js:612
msgid "The download did not work. Please try again."
msgstr "Lo scarico non è riuscito. Riprova."

#: assets/js/search.js:647 assets/js/search.js:1182
msgid "Remove all filters"
msgstr "Togli tutti i filtri"

#: assets/js/search.js:656
msgid "No results."
msgstr "Nessun risultato."

#. translators: %s: the searched text
#: assets/js/search.js:659
msgid "No results for “%s”. Check the spelling or try a shorter text."
msgstr ""
"Nessun risultato per «%s». Controlla come è scritto o prova con un testo più "
"breve."

#. translators: 1: result type (e.g. Trails), 2: number of results
#: assets/js/search.js:669
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: assets/js/search.js:672 assets/js/search.js:728 assets/js/search.js:964
#: assets/js/search.js:968
msgid "These results are not available right now. Please try again later."
msgstr ""
"Questi risultati non sono disponibili in questo momento. Riprova più tardi."

#. translators: %s: number and type of results (e.g. 42 trails)
#: assets/js/search.js:681
msgid "See all: %s"
msgstr "Vedi tutti: %s"

#: assets/js/search.js:807
msgid "Remove from selection"
msgstr "Togli dalla selezione"

#: assets/js/search.js:807
msgid "Add to selection"
msgstr "Aggiungi alla selezione"

#. translators: 1: routes loaded so far, 2: routes to load
#: assets/js/search.js:854
msgid "Loading the routes: %1$s of %2$s"
msgstr "Carico i tracciati: %1$s di %2$s"

#: assets/js/search.js:875
msgid "Close"
msgstr "Chiudi"

#: assets/js/search.js:893
msgid "Framed on the area that contains all the results"
msgstr "Inquadratura sul riquadro che contiene tutti i risultati"

#. translators: %s: selected results, e.g. 3 trails selected
#: assets/js/search.js:897
msgid "%s. The other results are dashed."
msgstr "%s. Gli altri risultati sono tratteggiati."

#. translators: %s: selected results, e.g. 3 trails selected
#: assets/js/search.js:900
msgid "Framed on the selection: %s. The other results are dashed."
msgstr ""
"Inquadratura sulla selezione: %s. Gli altri risultati sono tratteggiati."

#. translators: %s: number of results, e.g. 3 trails
#: assets/js/search.js:904
msgid "Not on the map because they have no route: %s."
msgstr "Non sono sulla mappa perché senza tracciato: %s."

#: assets/js/search.js:1073
msgid "Show less"
msgstr "Mostra meno"

#: assets/js/search.js:1073
msgid "Show more"
msgstr "Mostra altro"

#: assets/js/search.js:1118
msgid "Previous page"
msgstr "Pagina precedente"

#. translators: %s: page number
#: assets/js/search.js:1124
msgid "Page %s"
msgstr "Pagina %s"

#: assets/js/search.js:1127
msgid "Next page"
msgstr "Pagina successiva"

#: assets/js/search.js:1154
msgid "Active filters:"
msgstr "Filtri attivi:"

#. translators: 1: filter name (e.g. Activity), 2: filter value (e.g. Mountain bike)
#: assets/js/search.js:1164
msgid "Remove filter %1$s: %2$s"
msgstr "Togli il filtro %1$s: %2$s"

#. translators: %s: total length, e.g. 179.5 km
#: assets/js/source-tracks.js:222
msgid "%s in total"
msgstr "%s complessivi"

#: includes (oc:8969)
msgid "Detail pages"
msgstr "Pagine di dettaglio"

#: includes (oc:8969)
msgid "By default the address of a detail page starts with its type: the route type of a track (e.g. /trail/…, /track/ without one) and the POI type of a point of interest (/poi/ without one). Under a page, every address starts with the path of that page."
msgstr "Di norma l'indirizzo di una pagina di dettaglio inizia con il suo tipo: il tipo di percorso di una traccia (es. /sentiero/…, /track/ se non ce l'ha) e il tipo di un punto di interesse (/poi/ se non ce l'ha). Sotto una pagina, ogni indirizzo inizia con il percorso di quella pagina."

#: includes (oc:8969)
msgid "Points of interest"
msgstr "Punti di interesse"

#: includes (oc:8969)
msgid "Address under a page"
msgstr "Indirizzo sotto una pagina"

#: includes (oc:8969)
msgid "Page"
msgstr "Pagina"

#: includes (oc:8969)
msgid "Set by the theme: changes here have no effect."
msgstr "Impostato dal tema: le modifiche qui non hanno effetto."

#: includes (oc:8969)
msgid "Page temporarily unavailable"
msgstr "Pagina momentaneamente non disponibile"

#: includes (oc:8969)
msgid "The data of this page cannot be loaded right now. Please try again in a few minutes."
msgstr "In questo momento non è possibile caricare i dati di questa pagina. Riprova tra qualche minuto."

#. Description of the plugin
msgid "Unified site search and detail pages for Webmapp shards: tracks and POIs from the shard APIs, sources added by the theme."
msgstr "Ricerca unica del sito e pagine di dettaglio per gli shard Webmapp: tracce e POI dalle API dello shard, source aggiunte dal tema."
